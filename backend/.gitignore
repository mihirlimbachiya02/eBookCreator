# ── Environment variables — NEVER commit these ────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Runtime data ──────────────────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/

# ── Uploaded files — never commit user data ───────────────────────────────────
uploads/
uploads/**
uploads/books/
uploads/profiles/
uploads/profile-pics/

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Coverage ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Debug ─────────────────────────────────────────────────────────────────────
.node_repl_history

# ── Postman exports — may contain tokens ─────────────────────────────────────
*.postman_collection.json
*.postman_environment.json

# ── PM2 — may contain env vars ────────────────────────────────────────────────
ecosystem.config.js

# ── Cloudinary ────────────────────────────────────────────────────────────────
.cloudinary/
.cloudinary-cache/

# ── Debug scripts — never commit ─────────────────────────────────────────────
fixCovers.mjs
checkCovers.mjs
checkSpecific.mjs
*.debug.mjs
*.debug.js

# ── Package lock ──────────────────────────────────────────────────────────────
package-lock.json